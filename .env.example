# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# Clerk — from the Clerk dashboard under "API keys"
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Note: CLERK_JWT_ISSUER_DOMAIN is NOT set here. It belongs to the Convex
# deployment, not the app:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
